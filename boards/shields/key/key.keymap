#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define LOWER 1

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                // Левая половина (6 столбцов)                // Правая половина (6 столбцов)
                &kp ESC     &kp Q     &kp W    &kp E    &kp R     &kp T      &none &none &none &none &none &none
                &kp TAB     &kp A     &kp S    &kp D    &kp F     &kp G      &none &none &none &none &none &none
                &kp LSHIFT     &kp Z     &kp X    &kp C    &kp V     &kp B      &none &none &none &none &none &none
                &kp LCTRL  &kp LGUI  &none    &bt BT_CLR   &kp SPACE &kp LALT     &none &none &none &none &none &none
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp GRAVE  &kp 1     &kp 2     &kp 3     &kp 4     &kp 5      &none &none &none &none &none &none
                &kp 6      &kp 7     &kp 8     &kp 9     &kp 0     &kp MINUS  &none &none &none &none &none &none
                &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp SEMI  &kp SQT    &none &none &none &none &none &none
                &trans     &trans    &trans    &trans    &trans    &trans     &none &none &none &none &none &none
            >;
        };
    };
};

