#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0

/ {
    keymap {
        compatible = "zmk,keymap";

        // Базовый слой (слой 0)
        base_layer {
            display-name = "Base";
            bindings = <
    &kp ESC &kp Q &kp W &kp E &kp R &kp T   // 6 элементов
    &kp TAB &kp A &kp S &kp D &kp F &kp G   // 6 элементов
    &mt LSHFT &kp Z &kp X &kp C &kp V &kp B // 6 элементов
    &kp LCTRL &kp LGUI &none &out OUT_TOG &kp SPACE &kp BSPC // 6 элементов
>;
        };
    };
};
