#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUMPAD 1

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC         &kp Q       &kp W     &kp E     &kp R     &kp T        &none &none &none &none &none &none
                &kp TAB         &kp A       &kp S     &kp D     &kp F     &kp G        &none &none &none &none &none &none
                &kp LSHIFT      &kp Z       &kp X     &kp C     &kp V     &kp B        &none &none &none &none &none &none
                &kp LCTRL       &kp LALT    &none     &mo NUMPAD &kp SPACE &kp ENTER    &none &none &none &none &none &none
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
                // При зажатом NUMPAD: самая верхняя левая кнопка (бывший ESC) сотрет Bluetooth устройства!
                &bt BT_CLR      &kp N7      &kp N8    &kp N9    &kp ASTRK &none        &none &none &none &none &none &none
                &none           &kp N4      &kp N5    &kp N6    &kp PLUS  &none        &none &none &none &none &none &none
                &none           &kp N1      &kp N2    &kp N3    &kp MINUS &none        &none &none &none &none &none &none
                &trans          &trans      &none     &trans    &kp N0    &kp DOT      &none &none &none &none &none &none
            >;
        };
    };
};
