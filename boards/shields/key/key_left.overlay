#include "key.dtsi"

&default_transform {
    col-offset = <6>; // Смещение для правой половины
};

&kscan0 {
    col-gpios
        = <&pro_micro 8 GPIO_ACTIVE_HIGH> // Столбец 0
        , <&pro_micro 7 GPIO_ACTIVE_HIGH> // Столбец 1
        , <&pro_micro 6 GPIO_ACTIVE_HIGH> // Столбец 2
        , <&pro_micro 5 GPIO_ACTIVE_HIGH> // Столбец 3
        , <&pro_micro 0 GPIO_ACTIVE_HIGH> // Столбец 4
        , <&pro_micro 2 GPIO_ACTIVE_HIGH> // Столбец 5
        ;

    row-gpios
        = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Строка 0
        , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Строка 1
        , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Строка 2
        , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Строка 3
        ;
};
